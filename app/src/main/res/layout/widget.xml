<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="10dp"
    android:layoutDirection="rtl">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tab0" style="@style/Tab" />
        <TextView android:id="@+id/tab1" style="@style/Tab" />
        <TextView android:id="@+id/tab2" style="@style/Tab" />
        <TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="end|center_vertical" android:textColor="#8B949E"
            android:textSize="11sp" android:maxLines="1" />
        <TextView android:id="@+id/refresh" android:layout_width="32dp" android:layout_height="32dp"
            android:gravity="center" android:text="⟳" android:textColor="#58A6FF" android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/body" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:paddingTop="4dp">
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:text="לא נבחרו פריטים — הקישו כדי לבחור" android:textColor="#8B949E"
            android:textSize="13sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/name0" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="#E6EDF3" android:textSize="14sp" android:maxLines="1"
                android:ellipsize="end" android:textAlignment="viewStart" />
            <TextView android:id="@+id/price0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E6EDF3" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold"
                android:textDirection="ltr" />
            <TextView android:id="@+id/chg0" android:layout_width="62dp" android:layout_height="wrap_content"
                android:textColor="#8B949E" android:textSize="11sp" android:fontFamily="monospace"
                android:textDirection="ltr" android:gravity="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/name1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="#E6EDF3" android:textSize="14sp" android:maxLines="1"
                android:ellipsize="end" android:textAlignment="viewStart" />
            <TextView android:id="@+id/price1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E6EDF3" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold"
                android:textDirection="ltr" />
            <TextView android:id="@+id/chg1" android:layout_width="62dp" android:layout_height="wrap_content"
                android:textColor="#8B949E" android:textSize="11sp" android:fontFamily="monospace"
                android:textDirection="ltr" android:gravity="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/name2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="#E6EDF3" android:textSize="14sp" android:maxLines="1"
                android:ellipsize="end" android:textAlignment="viewStart" />
            <TextView android:id="@+id/price2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E6EDF3" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold"
                android:textDirection="ltr" />
            <TextView android:id="@+id/chg2" android:layout_width="62dp" android:layout_height="wrap_content"
                android:textColor="#8B949E" android:textSize="11sp" android:fontFamily="monospace"
                android:textDirection="ltr" android:gravity="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/name3" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="#E6EDF3" android:textSize="14sp" android:maxLines="1"
                android:ellipsize="end" android:textAlignment="viewStart" />
            <TextView android:id="@+id/price3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E6EDF3" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold"
                android:textDirection="ltr" />
            <TextView android:id="@+id/chg3" android:layout_width="62dp" android:layout_height="wrap_content"
                android:textColor="#8B949E" android:textSize="11sp" android:fontFamily="monospace"
                android:textDirection="ltr" android:gravity="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/name4" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="#E6EDF3" android:textSize="14sp" android:maxLines="1"
                android:ellipsize="end" android:textAlignment="viewStart" />
            <TextView android:id="@+id/price4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E6EDF3" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold"
                android:textDirection="ltr" />
            <TextView android:id="@+id/chg4" android:layout_width="62dp" android:layout_height="wrap_content"
                android:textColor="#8B949E" android:textSize="11sp" android:fontFamily="monospace"
                android:textDirection="ltr" android:gravity="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/name5" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="#E6EDF3" android:textSize="14sp" android:maxLines="1"
                android:ellipsize="end" android:textAlignment="viewStart" />
            <TextView android:id="@+id/price5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E6EDF3" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold"
                android:textDirection="ltr" />
            <TextView android:id="@+id/chg5" android:layout_width="62dp" android:layout_height="wrap_content"
                android:textColor="#8B949E" android:textSize="11sp" android:fontFamily="monospace"
                android:textDirection="ltr" android:gravity="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row6" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/name6" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="#E6EDF3" android:textSize="14sp" android:maxLines="1"
                android:ellipsize="end" android:textAlignment="viewStart" />
            <TextView android:id="@+id/price6" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E6EDF3" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold"
                android:textDirection="ltr" />
            <TextView android:id="@+id/chg6" android:layout_width="62dp" android:layout_height="wrap_content"
                android:textColor="#8B949E" android:textSize="11sp" android:fontFamily="monospace"
                android:textDirection="ltr" android:gravity="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
